{
  "name": "zhiliao-client",
  "version": "0.3.68",
  "description": "知了猴整蛊台 - Steam 式 mod 库 + 游戏启动 + 参数调整 + 直播连接器",
  "main": "out/main/index.js",
  "author": "知了猴工作室",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "gifts:sync": "node tools/sync-douyin-gifts.mjs",
    "gifts:import-live": "node tools/import-douyin-live-gifts.mjs",
    "gifts:verify": "node tools/verify-douyin-gifts.mjs",
    "test:entertainment": "electron-vite build && node tools/test-entertainment-electron.mjs",
    "test:entertainment:nobuild": "node tools/test-entertainment-electron.mjs",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "electron-updater": "^6.3.9",
    "jszip": "^3.10.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sql.js": "^1.14.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "playwright-core": "^1.62.1",
    "postcss": "^8.4.49",
    "rcedit": "^5.0.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/626YY/zhiliaohou-client.git"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
